/* =========================
   ACCESSIBILITY
========================= */

/* The orbit is an intentional part of the visual cycle and remains active. */
.sr-only {
  position: absolute;

  width: 1px;
  height: 1px;

  padding: 0;
  margin: -1px;

  overflow: hidden;

  clip: rect(0, 0, 0, 0);

