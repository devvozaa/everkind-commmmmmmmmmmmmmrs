</style>


<script>
  function initConsumerCycle() {
    const roots =
      document.querySelectorAll("[data-consumer-cycle]");

    roots.forEach(function (root) {

      if (root.dataset.ready === "true") {
        return;
      }

      root.dataset.ready = "true";

      const cards =
        Array.from(
          root.querySelectorAll(".stage")
        );

      let active = 0;

      function updateActive(index) {
        active = index;

        cards.forEach(function (card, i) {
          card.setAttribute(
            "aria-pressed",
            String(i === active)
          );
        });
      }

      const timer = window.setInterval(
        function () {
          updateActive(
            (active + 1) % cards.length
          );
        },
        3600
      );

      cards.forEach(function (card, index) {

        card.addEventListener(
          "click",
          function () {
            updateActive(index);
          }
        );

      });

      document.addEventListener(
        "astro:before-swap",
        function () {
          window.clearInterval(timer);
        },
        { once: true }
      );

    });
  }

  initConsumerCycle();

  document.addEventListener(
    "astro:page-load",
    initConsumerCycle
  );
</script>
