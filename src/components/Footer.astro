---
import everkindLogo from "../assets/EverkindLogo.svg";
import herbalWisdomLogo from "../assets/Illustration1.png";
---

{
  /* Increased outer padding to pt-24 to clear the overflowing SVG from the CTA section */
}
<div class="w-full bg-(--color-everkind-bg) pt-4">
  <footer
    class="bg-(--color-everkind-darkgrey) text-(--color-everkind-bg) rounded-t-[2.5rem] pt-12 pb-8 px-8 sm:px-12 md:px-16 lg:px-24 max-w-6xl mx-auto w-full"
    style="font-family: var(--font-sans);"
  >
    {/* ── TIER 1: Logo & Navigation ── */}
    <div
      class="flex flex-col lg:flex-row justify-between items-center gap-8 lg:gap-0"
    >
      <div
        class="shrink-0 hover:opacity-80 transition-opacity duration-300 cursor-pointer"
      >
        <img
          src={everkindLogo.src}
          alt="Everkind Logo"
          class="h-7 md:h-8 w-auto"
        />
      </div>

      <nav
        aria-label="Footer Navigation"
        class="flex flex-wrap justify-center lg:justify-end gap-6 md:gap-10 text-sm md:text-base font-light"
      >
        {
          [
            { name: "About us", path: "/about" },
            //{ name: "Our Brands", path: "/#brands" },
            { name: "Investors", path: "/investors" },
            { name: "Opportunities", path: "/opportunities" },
            { name: "Writing", path: "/blog" },
          ].map((link) => (
            <a
              href={link.path}
              class="relative group text-(--color-everkind-bg)/80 hover:text-(--color-everkind-bg) transition-colors duration-300 py-1"
            >
              {link.name}
              <span class="absolute left-0 bottom-0 w-0 h-px bg-(--color-everkind-bg) transition-all duration-300 ease-out group-hover:w-full" />
            </a>
          ))
        }
      </nav>
    </div>

    {/* ── TIER 2: Contact Info & Newsletter ── */}
    {/* Reduced top margin from mt-16 to mt-10 */}
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 mt-10 items-start"
    >
      {/* Left: Contact Info ONLY */}
      <div class="flex flex-col items-start gap-4">
        {/* Tightened gap-5 to gap-4 */}
        <div
          class="bg-(--color-everkind-green) text-(--color-everkind-bg) px-3 py-1 rounded-md text-lg lg:text-xl tracking-wide"
          style="font-family: var(--font-serif);"
        >
          Contact us:
        </div>

        <div
          class="flex flex-col gap-2 text-(--color-everkind-bg) text-sm sm:text-[15px] font-light tracking-wide mt-1"
          style="font-family: var(--font-sans);"
        >
          <p>
            Email: <a
              href="mailto:contact@everkindconsumer.com"
              class="hover:opacity-70 transition-opacity duration-300"
              >contact@everkindconsumer.com</a
            >
          </p>
          <p>
            WhatsApp: <a
              href="https://wa.me/919187614095"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:opacity-70 transition-opacity duration-300"
              >9187614095</a
            >
          </p>
        </div>
      </div>

      {/* Right: Newsletter Box */}
      <div class="w-full flex flex-col items-center md:items-end gap-4">
        {/* Tightened gap-5 to gap-4 */}
        {/*
<div class="w-full flex flex-wrap justify-center md:justify-end gap-3 sm:gap-4">
  <a
    href="https://theherbalwisdom.com/"
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center justify-center px-6 py-3 border border-(--color-everkind-bg)/20 rounded-md hover:border-(--color-everkind-bg)/60 bg-(--color-everkind-bg)/5 hover:bg-(--color-everkind-bg)/10 transition-all duration-300"
  >
    <img
      src={herbalWisdomLogo.src}
      alt="The Herbal Wisdom"
      class="h-15 w-auto object-contain opacity-60 group-hover:opacity-100 transition-opacity duration-300 invert"
    />
  </a>
</div>
*/}
        <a
          href="https://www.linkedin.com/company/everkind-consumers/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Everkind Consumers on LinkedIn"
          class="group inline-flex items-center justify-center w-9 h-9 rounded-md border border-(--color-everkind-bg)/20 text-(--color-everkind-bg)/70 hover:text-(--color-everkind-bg) hover:border-(--color-everkind-bg)/60 bg-(--color-everkind-bg)/5 hover:bg-(--color-everkind-bg)/10 transition-all duration-300"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="w-5 h-5 fill-current"
          >
            <path
              d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.8-2.1 3.8-2.1 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4V9Z"
            />
          </svg>
        </a>
      </div>
    </div>

    {/* ── TIER 4: Copyright & Legal ── */}
    {/* Reduced top margin from mt-12 to mt-10 */}
    <hr class="border-(--color-everkind-bg)/20 mt-10 mb-5" />

    <div
      class="flex flex-col md:flex-row justify-between items-center gap-3 text-xs sm:text-sm text-(--color-everkind-bg)/60 font-light"
      style="font-family: var(--font-sans);"
    >
      <p>
        &copy; {new Date().getFullYear()} Everkind Consumers. All Rights Reserved.
      </p>

      <a
        href="/privacy-policy"
        class="relative group hover:text-(--color-everkind-bg) transition-colors duration-300 py-1"
      >
        Privacy Policy
        <span
          class="absolute left-0 bottom-0 w-0 h-px bg-(--color-everkind-bg) transition-all duration-300 ease-out group-hover:w-full"
        ></span>
      </a>
    </div>
  </footer>
</div>
