---
// src/components/BlogCard.astro
const { post } = Astro.props;

// LOGIC: If an external link exists, use it. Otherwise, use the local slug.
const isExternal = Boolean(post.externalLink);
const href = isExternal ? post.externalLink : `/blog/${post.slug}`;
const target = isExternal ? "_blank" : "_self";
---

<a 
  href={href} 
  target={target}
  rel={isExternal ? "noopener noreferrer" : ""}
  class="group flex flex-col gap-5 cursor-pointer bg-(--color-everkind-lightgrey) hover:bg-(--color-everkind-lightgrey)/80 p-5 sm:p-6 rounded-4xl transition-all duration-300 h-full border border-(--color-everkind-dark)/5"
>
  {/* Card Image Container */}
  <div class="w-full aspect-4/3 overflow-hidden rounded-2xl bg-(--color-everkind-dark)/5 shrink-0">
    <img 
      src={post.imageUrl} 
      alt={post.title} 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  </div>

  {/* Card Text Content */}
  <div class="flex flex-col grow gap-3">
    
    {/* Category & Date Info */}
    <div class="flex items-center gap-3 text-xs sm:text-sm font-semibold tracking-widest uppercase text-(--color-everkind-green)" style="font-family: var(--font-sans);">
      <span>{post.category}</span>
      <span class="w-1.5 h-1.5 rounded-full bg-(--color-everkind-green)/30"></span>
      <span class="text-(--color-everkind-midgrey)">{post.date}</span>
    </div>

    {/* Article Title */}
    <h3 
      class="text-2xl sm:text-3xl text-(--color-everkind-dark) leading-[1.1] group-hover:text-(--color-everkind-green) transition-colors duration-300"
      style="font-family: var(--font-serif);"
    >
      {post.title}
    </h3>

    {/* Excerpt */}
    <p 
      class="text-sm sm:text-base text-(--color-everkind-darkgrey) leading-relaxed line-clamp-3 mb-2"
      style="font-family: var(--font-sans);"
    >
      {post.excerpt}
    </p>

    {/* Bottom Link with Arrow */}
    <div 
      class="mt-auto inline-flex items-center gap-2 text-(--color-everkind-darkgrey) font-medium text-sm sm:text-base whitespace-nowrap"
      style="font-family: var(--font-sans);"
    >
      <span class="border-b border-transparent group-hover:border-(--color-everkind-green) transition-all duration-300">
        {isExternal ? 'Read on Source' : 'Read article'}
      </span>
      <svg 
        xmlns="http://www.w3.org/2000/svg" 
        class={`w-5 h-5 shrink-0 transform transition-transform duration-300 group-hover:translate-x-1.5 group-hover:text-(--color-everkind-green) ${isExternal ? '-rotate-45' : ''}`} 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        stroke-width="1.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </div>
    
  </div>
</a>