---

interface Props {
  compact?: boolean;
  mobileTight?: boolean;
}

const { compact = false, mobileTight = false } = Astro.props;
---

<section class:list={["w-full bg-white px-6 sm:px-12 md:px-16 lg:px-24", compact ? "py-2 sm:py-3 md:py-5" : "py-8 sm:py-10 md:py-14", mobileTight && "cta-mobile-tight"]}>
    <div class:list={["relative max-w-6xl mx-auto bg-(--color-everkind-lightgrey) rounded-2xl px-5 sm:px-8 md:px-10 flex flex-col items-center md:items-start min-h-0 gap-5 md:gap-4", compact ? "py-5 sm:py-6 md:py-7" : "py-7 sm:py-8 md:py-9"]}>

    {/* ── LEFT: Text + CTA ── */}
    <div class="flex flex-col items-center text-center md:items-start md:text-left gap-4 sm:gap-5 w-full md:max-w-[50%] lg:max-w-[55%] relative z-10">

      <h2
        class="text-2xl sm:text-3xl md:text-4xl text-(--color-everkind-dark) font-normal leading-[1.05] tracking-tight"
        style="font-family: var(--font-serif);"
      >
        Let's make things happen
      </h2>

      <p
        class="text-sm sm:text-base md:text-base text-(--color-everkind-dark) opacity-100 leading-relaxed max-w-xl mx-auto md:mx-0"
        style="font-family: var(--font-sans);"
      >
        Contact us if you would like to work with us or would like to collaborate in any other way.
      </p>

      <a
        href="mailto:contact@everkindconsumer.com"
        class="w-full sm:w-auto px-7 sm:px-8 py-3.5 sm:py-4 text-sm sm:text-base text-white bg-(--color-everkind-dark) rounded-2xl hover:opacity-80 transition-opacity duration-300"
        style="font-family: var(--font-sans);"
      >
        Contact Us
      </a>
    </div>

  </div>
</section>

<style>
  @media (max-width: 767px) {
    .cta-mobile-tight {
      padding-top: 0.5rem;
    }
  }
</style>