        >
          <span class="w-1.5 h-1.5 rounded-full bg-white opacity-80 animate-bounce" style="animation-delay: 0ms"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-white opacity-80 animate-bounce" style="animation-delay: 150ms"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-white opacity-80 animate-bounce" style="animation-delay: 300ms"></span>
        </span>

        <p
          class="text-2xl sm:text-3xl leading-snug tracking-tight"
          style="font-family: var(--font-serif); color: var(--color-everkind-dark);"
