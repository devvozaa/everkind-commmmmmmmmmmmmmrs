---
// src/layouts/Layout.astro

// 1. Import your global stylesheet here!
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
// ... any other imports or props you might have
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" >
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<title>{title}</title>
		 <Analytics />
		 <SpeedInsights />
		 {/* 2. Add any global scripts or styles here */}
		 {/* For example, if you want to add a global script for analytics or a UI library, you can do it here */}
	</head>
	<body class="antialiased bg-white min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-1 w-full">
			<slot />
		</main>
		<Footer />
		{/* 3. Global Lenis Smooth Scroll, Parallax, & Routing Engine */}
    <script>
    	  import Lenis from 'lenis';
    	  const lenis = new Lenis({
    	    autoRaf: true,
    	    duration: 1.5,
    	    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    	    smoothWheel: true,
    	  });

    	  document.addEventListener('DOMContentLoaded', () => {
    	    const parallaxElements = document.querySelectorAll('[data-parallax]');
    	    lenis.on('scroll', (e) => {
    	      parallaxElements.forEach((el) => {
    	        const speed = parseFloat(el.getAttribute('data-parallax') || '0.1');
    	        (el as HTMLElement).style.transform = `translateY(${e.scroll * speed}px)`;
    	      });
    	    });
    	  });
		  function raf(time: number) {
		    lenis.raf(time);
		    requestAnimationFrame(raf);
		  }
    	  document.addEventListener('DOMContentLoaded', () => {
    	    // A. Handle arriving from another page
    	    // Check if we left a "note" to scroll to a specific section
    	    const pendingScroll = sessionStorage.getItem('crossPageScroll');
    	    if (pendingScroll) {
    	      sessionStorage.removeItem('crossPageScroll'); // Clear the note
			
    	      // Wait 300ms so the user sees the top of the home page load, then glide down
    	      setTimeout(() => {
    	        const targetEl = document.getElementById(pendingScroll);
    	        if (targetEl) {
    	          lenis.scrollTo(targetEl, { offset: -100, duration: 2 }); 
    	        }
    	      }, 300);
    	    }

    	    // B. Intercept all clicks on anchor links across the entire site
			document.querySelectorAll('a[href*="#"]').forEach(anchor => {
			  anchor.addEventListener('click', function (this: HTMLAnchorElement, e) {
				const href = this.getAttribute('href');
    	        if (!href) return;
    	        const [path, hash] = href.split('#');
    	        if (!hash) return; 

    	        const currentPath = window.location.pathname;
    	        const targetPath = path || currentPath; 
			
    	        // Check if the link goes to the page we are currently looking at
    	        const isSamePage = currentPath === targetPath || (currentPath === '/' && targetPath === '');

    	        if (isSamePage) {
    	          e.preventDefault();
    	          const targetEl = document.getElementById(hash);
    	          if (targetEl) lenis.scrollTo(targetEl, { offset: -100 });
    	        } else {
    	          e.preventDefault();
    	          sessionStorage.setItem('crossPageScroll', hash);
    	          window.location.href = targetPath || '/';
    	        }
    	      });
    	    });
    	  });
    	</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
