---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

import OurBrands from '../components/OurBrands.astro';
import CTA from '../components/CTA.astro';
import OperatingModel from '../components/OperatingModel.astro';

import WhyChooseUs from '../components/WhyChooseUs.astro';
---

<Layout title="Everkind Consumers">
	<main>
			<Hero />
			<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
			<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
			<script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
			
			<section id="everkind-ai-consumer-company" class="everkind-ai-section" aria-label="Everkind — A New Kind of Consumer Company">
				<style is:inline>
/* ==========================================================================
   EVERKIND — Exact Brand Guidelines (Everkind Green #0B3D25 Typography)
   Colors: Everkind Green (#0B3D25), Dark (#000000), BG (#FFFFFF), Light Grey (#F3F3F3)
   Fonts: GFS Didot (Display Serif) & Inter (Sans-Serif)
   ========================================================================== */

:root {
  /* Brand Colors */
  --color-everkind-green: #0B3D25;
  --color-everkind-dark: #000000;
  --color-everkind-bg: #FFFFFF;
  --color-everkind-lightgrey: #F3F3F3;
  --color-everkind-darkgrey: #191A23;
  --color-everkind-midgrey: #292A32;
  --color-everkind-lime: #C6F523;
  --border-subtle: rgba(11, 61, 37, 0.08);

  /* Brand Typography */
  --font-serif: "GFS Didot", Georgia, serif;
  --font-sans: "Inter", system-ui, -apple-system, sans-serif;
  --font-mono: "JetBrains Mono", monospace;
}

.everkind-ai-section {
  position: relative;
  width: 100%;
  background-color: var(--color-everkind-bg);
  color: var(--color-everkind-green);
  font-family: var(--font-serif);
  overflow-x: hidden;
}

/* ==========================================================================
   AMBIENT MOTION BACKGROUND & HERO AURA
   ========================================================================== */

.ambient-background {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

#ambientCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.65;
}

.hero-bg-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(198, 245, 35, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
  z-index: 0;
}

/* ==========================================================================
   MAIN SCROLL SECTIONS
   ========================================================================== */

.everkind-interactive-app {
  position: relative;
  z-index: 2;
  width: 100%;
}

.screen-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  box-sizing: border-box;
  padding: 2.5rem 5vw;
}

.mono-micro {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-everkind-midgrey);
}

.lime-dot {
  color: var(--color-everkind-lime);
  margin-right: 0.35rem;
}

/* ==========================================================================
   SCREEN 1: HERO ROUNDED CARD SECTION (EVERKIND GREEN #0B3D25 TYPOGRAPHY)
   ========================================================================== */

.hero-section {
  min-height: auto;
  padding: 2rem 5vw;
}

/* Background Orbit Graphic Behind Text */
.hero-orbit-wrapper {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 580px;
  height: 580px;
  pointer-events: none;
  z-index: 1;
}

.hero-orbit-svg {
  width: 100%;
  height: 100%;
  animation: slowOrbitRotate 90s linear infinite;
  transform-origin: center center;
}

@keyframes slowOrbitRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.hero-inner {
  max-width: 1100px;
  width: 100%;
  background-color: var(--color-everkind-lightgrey);
  border-radius: 24px;
  padding: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  border: 1px solid var(--border-subtle);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
}

.hero-headline {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 4.4vw, 3.8rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-weight: 400;
  color: var(--color-everkind-green); /* Everkind Green #0B3D25 */
  text-align: center;
  margin: 0 auto;
}

/* INLINE TOGGLE SWITCH MATCHING CONSUMER TEXT PERFECTLY */
.o-toggle {
  display: inline-flex;
  align-items: center;
  position: relative;
  width: 1.52em;
  height: 0.72em;
  vertical-align: 0.02em;
  margin: 0 0.04em;
  border-radius: 9999px;
  background-color: var(--color-everkind-dark);
  border: none;
  cursor: pointer;
  outline: none;
  padding: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
  transition: transform 0.25s ease, background-color 0.3s ease;
}

.o-toggle:hover {
  transform: scale(1.04);
}

.o-toggle:focus-visible {
  box-shadow: 0 0 0 3px rgba(198, 245, 35, 0.6);
}

.toggle-track {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 9999px;
}

.toggle-knob {
  position: absolute;
  top: 50%;
  left: 0.06em;
  transform: translateY(-50%);
  width: 0.6em;
  height: 0.6em;
  border-radius: 50%;
  background-color: var(--color-everkind-lime);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
}

.o-toggle.is-active .toggle-knob {
  transform: translate(0.8em, -50%);
}

/* In-place Morph Statement Revealed ONLY WHEN TOGGLE IS ON */
.hero-statement-container {
  margin-top: 1.5rem;
  max-width: 780px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-toggle-statement {
  font-family: var(--font-serif);
  font-size: clamp(1.15rem, 2.2vw, 1.65rem);
  line-height: 1.35;
  color: var(--color-everkind-green); /* Everkind Green #0B3D25 */
  opacity: 0;
  filter: blur(12px);
  transform: translateY(16px);
  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
              filter 0.6s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}

.hero-toggle-statement.is-active {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0);
  pointer-events: auto;
}

/* Pulsating Scroll Down Arrow Indicator Revealed ONLY WHEN TOGGLE IS ON */
.hero-scroll-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  margin-top: 1.25rem;
  opacity: 0;
  transform: translateY(12px);
  pointer-events: none;
  transition: opacity 0.5s ease 0.2s, transform 0.5s ease 0.2s;
}

.hero-scroll-arrow.is-active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.arrow-svg {
  width: 22px;
  height: 22px;
  color: var(--color-everkind-green); /* Everkind Green #0B3D25 */
  animation: pulseBounce 1.8s infinite;
}

@keyframes pulseBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

.hero-footer-micro {
  margin-top: 1.75rem;
  text-align: center;
}

.emphasis-italic {
  font-style: italic;
  color: var(--color-everkind-green);
}

/* ==========================================================================
   SCREEN 2: LIFECYCLE STAGES (EVERKIND GREEN #0B3D25 HEADINGS)
   ========================================================================== */

.lifecycle-section {
  min-height: auto;
  padding: 1.5rem 5vw 4rem;
}

.lifecycle-container {
  max-width: 1100px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 2.25rem;
}

.stage-display-card {
  background-color: var(--color-everkind-lightgrey);
  border-radius: 24px;
  border: 1px solid var(--border-subtle);
  padding: clamp(2rem, 4vw, 3.25rem);
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  width: 100%;
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.stage-display-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 48px rgba(11, 61, 37, 0.05);
}

.card-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(11, 61, 37, 0.1);
}

.card-content-grid {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 2.5rem;
}

.stage-display-card.card-reverse .card-content-grid {
  flex-direction: row-reverse;
}

.card-visual-box {
  width: 260px;
  height: 260px;
  background: #FFFFFF;
  border-radius: 16px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid rgba(11, 61, 37, 0.08);
}

.stageCanvas {
  width: 100%;
  height: 100%;
  display: block;
}

.card-detail-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.85rem;
}

.card-subtitle {
  color: var(--color-everkind-midgrey);
}

.card-heading {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  line-height: 1.2;
  font-weight: 400;
  color: var(--color-everkind-green); /* Everkind Green #0B3D25 */
}

.card-desc {
  font-family: var(--font-sans);
  font-size: 0.92rem;
  line-height: 1.55;
  color: var(--color-everkind-midgrey);
  max-width: 480px;
}

.blur-card {
  opacity: 0;
  filter: blur(16px);
  transform: translateY(28px);
  will-change: opacity, filter, transform;
  transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
              filter 0.85s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
}

.blur-card.is-visible {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0);
}

/* ==========================================================================
   SCREEN 3: FINAL THESIS (EVERKIND GREEN #0B3D25 CARD BACKGROUND)
   ========================================================================== */

.thesis-section {
  min-height: auto;
  padding: 3rem 5vw 4rem;
  background-color: transparent;
}

.thesis-card-wrapper {
  max-width: 1100px;
  width: 100%;
  margin: 0 auto;
  background-color: var(--color-everkind-green); /* Everkind Green #0B3D25 */
  border-radius: 24px;
  color: var(--color-everkind-bg);
  padding: clamp(3.5rem, 6vw, 5rem) clamp(2rem, 4vw, 4rem);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.thesis-spotlight {
  position: absolute;
  width: 600px;
  height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(198, 245, 35, 0.12) 0%, rgba(11, 61, 37, 0) 70%);
  pointer-events: none;
  transform: translate(-50%, -50%);
  top: 50%;
  left: 50%;
  transition: opacity 0.5s ease;
}

.thesis-top-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2.5rem;
}

.thesis-top-bar .mono-micro {
  color: rgba(255, 255, 255, 0.7);
}

.thesis-inner {
  max-width: 920px;
  width: 100%;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  text-align: center;
}

.thesis-text {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 2.8vw, 2.4rem);
  line-height: 1.32;
  font-weight: 400;
  color: var(--color-everkind-bg);
  letter-spacing: -0.01em;
  text-align: center;
}

.blur-reveal-text {
  opacity: 0;
  filter: blur(20px);
  transform: translateY(30px);
  will-change: opacity, filter, transform;
  transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1),
              filter 1.1s cubic-bezier(0.16, 1, 0.3, 1),
              transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
}

.blur-reveal-text.is-visible {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0);
}

.lime-italic {
  font-style: italic;
  color: var(--color-everkind-lime);
  font-weight: 400;
}

.highlight-white {
  font-weight: 400;
  color: var(--color-everkind-bg);
  border-bottom: 2px solid var(--color-everkind-lime);
  padding-bottom: 2px;
}

.thesis-footer {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 3.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  padding-top: 1.5rem;
}

.thesis-footer .mono-micro {
  color: rgba(255, 255, 255, 0.6);
}

/* ==========================================================================
   RESPONSIVE BREAKPOINTS
   ========================================================================== */

@media (max-width: 900px) {
  .hero-inner {
    padding: 3rem 1.5rem;
    border-radius: 18px;
  }

  .hero-headline {
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    line-height: 1.08;
  }

  .o-toggle {
    width: 1.4em;
    height: 0.66em;
  }

  .o-toggle.is-active .toggle-knob {
    transform: translate(0.72em, -50%);
  }

  .hero-toggle-statement {
    font-size: clamp(1.1rem, 3.5vw, 1.4rem);
  }

  .stage-display-card {
    padding: 1.5rem;
    border-radius: 18px;
  }

  .card-content-grid,
  .stage-display-card.card-reverse .card-content-grid {
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .card-visual-box {
    width: 100%;
    height: 220px;
    border-radius: 12px;
  }

  .card-heading {
    font-size: clamp(1.4rem, 4.5vw, 1.8rem);
  }

  .thesis-card-wrapper {
    padding: 3rem 1.5rem;
    border-radius: 18px;
  }

  .thesis-text {
    font-size: clamp(1.3rem, 4.5vw, 1.8rem);
  }

  .hero-orbit-wrapper {
    width: 420px;
    height: 420px;
  }
}
				</style>

				<!-- Ambient Motion Graphics Layer & Orbital Rings Behind Content -->
				<div class="ambient-background" aria-hidden="true">
					<canvas id="ambientCanvas"></canvas>
					<div class="hero-bg-aura"></div>
				</div>

				<div class="everkind-interactive-app">

					<!-- SCREEN 1: HERO ROUNDED CARD SECTION (REF IMAGE MATCH) -->
					<section class="screen-section hero-section" id="hero">
						<div class="hero-orbit-wrapper" aria-hidden="true">
							<svg viewBox="0 0 600 600" class="hero-orbit-svg">
								<ellipse cx="300" cy="300" rx="260" ry="140" stroke="rgba(11, 61, 37, 0.12)" stroke-width="1.2" fill="none" transform="rotate(-15 300 300)" />
								<ellipse cx="300" cy="300" rx="220" ry="190" stroke="rgba(198, 245, 35, 0.25)" stroke-width="1.2" fill="none" stroke-dasharray="6 8" transform="rotate(25 300 300)" />
								<circle cx="160" cy="220" r="4" fill="#0B3D25" opacity="0.6" />
								<circle cx="450" cy="380" r="5" fill="#C6F523" />
							</svg>
						</div>

						<div class="hero-inner">
							<h1 class="hero-headline">
								We are building a new<br>
								kind of C<button class="o-toggle" id="oToggle" type="button" role="switch" aria-label="Toggle brand mode" aria-checked="false"><span class="toggle-track"><span class="toggle-knob"></span></span></button>nsumer<br>
								company
							</h1>

							<!-- In-place Morph Statement & Scroll Arrow Revealed ONLY WHEN TOGGLE IS ON -->
							<div class="hero-statement-container" id="heroStatementContainer">
								<p class="hero-toggle-statement" id="heroToggleStatement">
									One powered by AI that <span class="emphasis-italic">learns &amp; iterates</span> across the entire brand lifecycle.
								</p>

								<div class="hero-scroll-arrow" id="heroScrollArrow">
									<span class="mono-micro">SCROLL TO EXPLORE</span>
									<svg viewBox="0 0 24 24" class="arrow-svg">
										<path d="M12 4v16m0 0l-6-6m6 6l6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
									</svg>
								</div>
							</div>

							<div class="hero-footer-micro" id="heroFooterMicro">
								<span class="mono-micro" id="heroInstructionText">TAP THE TOGGLE TO BEGIN</span>
							</div>
						</div>
					</section>

					<!-- SCREEN 2: ALL 5 LIFECYCLE STAGES IN ROUNDED ZIGZAG CARDS (01 TO 05) -->
					<section class="screen-section lifecycle-section" id="lifecycle">
						<div class="lifecycle-container">

							<!-- CARD 01: CONSUMER INSIGHT -->
							<div class="stage-display-card blur-card" data-stage="1">
								<div class="card-top-bar">
									<span class="mono-micro">CURRENT STATE / 01</span>
									<span class="mono-micro">SYSTEM READY</span>
								</div>
								<div class="card-content-grid">
									<div class="card-visual-box">
										<canvas class="stageCanvas" id="canvasStage1" width="300" height="300"></canvas>
									</div>
									<div class="card-detail-panel">
										<span class="mono-micro card-subtitle">LISTEN BEFORE YOU BUILD.</span>
										<h2 class="card-heading">Consumer Insight</h2>
										<p class="card-desc">Turn weak signals into a clearer brief for what should exist next. Real-time sensing across emerging cultural trends and consumer desire.</p>
									</div>
								</div>
							</div>

							<!-- CARD 02: PRODUCT INNOVATION (ZIGZAG REVERSE) -->
							<div class="stage-display-card card-reverse blur-card" data-stage="2">
								<div class="card-top-bar">
									<span class="mono-micro">CURRENT STATE / 02</span>
									<span class="mono-micro">SYSTEM READY</span>
								</div>
								<div class="card-content-grid">
									<div class="card-visual-box">
										<canvas class="stageCanvas" id="canvasStage2" width="300" height="300"></canvas>
									</div>
									<div class="card-detail-panel">
										<span class="mono-micro card-subtitle">SYNTHESIZE FORM &amp; FUNCTION.</span>
										<h2 class="card-heading">Product Innovation</h2>
										<p class="card-desc">Rapid generative synthesis of formulations, designs, and value propositions tuned to verified consumer demand.</p>
									</div>
								</div>
							</div>

							<!-- CARD 03: LAUNCH -->
							<div class="stage-display-card blur-card" data-stage="3">
								<div class="card-top-bar">
									<span class="mono-micro">CURRENT STATE / 03</span>
									<span class="mono-micro">SYSTEM READY</span>
								</div>
								<div class="card-content-grid">
									<div class="card-visual-box">
										<canvas class="stageCanvas" id="canvasStage3" width="300" height="300"></canvas>
									</div>
									<div class="card-detail-panel">
										<span class="mono-micro card-subtitle">DEPLOY WITH INSTRUMENTATION.</span>
										<h2 class="card-heading">Launch</h2>
										<p class="card-desc">Targeted, adaptive deployment with live instrumentation across digital &amp; physical touchpoints.</p>
									</div>
								</div>
							</div>

							<!-- CARD 04: CONSUMER FEEDBACK (ZIGZAG REVERSE) -->
							<div class="stage-display-card card-reverse blur-card" data-stage="4">
								<div class="card-top-bar">
									<span class="mono-micro">CURRENT STATE / 04</span>
									<span class="mono-micro">SYSTEM READY</span>
								</div>
								<div class="card-content-grid">
									<div class="card-visual-box">
										<canvas class="stageCanvas" id="canvasStage4" width="300" height="300"></canvas>
									</div>
									<div class="card-detail-panel">
										<span class="mono-micro card-subtitle">CAPTURE REAL USAGE PATTERNS.</span>
										<h2 class="card-heading">Consumer Feedback</h2>
										<p class="card-desc">Direct telemetry from actual post-purchase experience, satisfaction loops, and organic sentiment.</p>
									</div>
								</div>
							</div>

							<!-- CARD 05: CONTINUOUS LEARNING -->
							<div class="stage-display-card blur-card" data-stage="5">
								<div class="card-top-bar">
									<span class="mono-micro">CURRENT STATE / 05</span>
									<span class="mono-micro">SYSTEM READY</span>
								</div>
								<div class="card-content-grid">
									<div class="card-visual-box">
										<canvas class="stageCanvas" id="canvasStage5" width="300" height="300"></canvas>
									</div>
									<div class="card-detail-panel">
										<span class="mono-micro card-subtitle">CLOSE THE ITERATION LOOP.</span>
										<h2 class="card-heading">Continuous Learning</h2>
										<p class="card-desc">Closing the loop automatically to feed learnings back into the next innovation cycle continuously.</p>
									</div>
								</div>
							</div>

						</div>
					</section>

					<!-- SCREEN 3: FINAL THESIS ROUNDED CARD SECTION -->
					<section class="screen-section thesis-section">
						<div class="thesis-card-wrapper" id="thesis">
							<div class="thesis-spotlight" id="thesisSpotlight"></div>

							<div class="thesis-top-bar">
								<span class="mono-micro left-tag"><span class="lime-dot">•</span> THE EVERKIND THESIS</span>
								<span class="mono-micro right-tag">SYSTEM READY</span>
							</div>

							<div class="thesis-inner">
								<p class="blur-reveal-text thesis-text" id="finalThesis">
									We believe the future of consumer brands may not be built by companies that are best at <em class="lime-italic">predicting</em> what consumers want. It may be built by companies that are best at continuously <em class="lime-italic">learning</em> what consumers want — and converting that learning into products <strong class="highlight-white">faster than everyone else</strong>.
								</p>
							</div>
						</div>
					</section>

				</div>

				<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  let isToggleActive = false;
  let lenisInstance = null;
  let audioCtx = null;

  // DOM Elements
  const oToggle = document.getElementById('oToggle');
  const heroToggleStatement = document.getElementById('heroToggleStatement');
  const heroScrollArrow = document.getElementById('heroScrollArrow');
  const heroInstructionText = document.getElementById('heroInstructionText');
  const thesisSection = document.getElementById('thesis');
  const thesisSpotlight = document.getElementById('thesisSpotlight');
  const systemStatusText = document.getElementById('systemStatusText');

  // Register GSAP Plugins
  if (window.gsap && window.ScrollTrigger) {
    gsap.registerPlugin(ScrollTrigger);
  }

  // Initialize Smooth Scroll Engine
  initSmoothScroll();

  // Initialize Hero Toggle (SHOW STATEMENT & SCROLL ARROW ONLY WHEN ON)
  initToggleSwitch();

  // Initialize Thesis Spotlight
  initThesisSpotlight();

  // Initialize Scroll Triggers
  initScrollTriggers();

  // Initialize Canvases for Stage 1 to 5
  initAmbientBackgroundCanvas();
  initStageCanvases();

  /* ==========================================================================
     1. HERO TOGGLE SWITCH HANDLER (SHOW STATEMENT & SCROLL ARROW ONLY WHEN ON)
     ========================================================================== */

  function initToggleSwitch() {
    if (!oToggle) return;

    oToggle.addEventListener('click', (e) => {
      e.preventDefault();
      isToggleActive = !isToggleActive;

      oToggle.classList.toggle('is-active', isToggleActive);
      oToggle.setAttribute('aria-checked', isToggleActive ? 'true' : 'false');

      // Show statement & scroll arrow ONLY WHEN TOGGLE IS ON!
      if (heroToggleStatement) {
        heroToggleStatement.classList.toggle('is-active', isToggleActive);
      }
      if (heroScrollArrow) {
        heroScrollArrow.classList.toggle('is-active', isToggleActive);
      }

      if (heroInstructionText) {
        heroInstructionText.textContent = isToggleActive
          ? 'SCROLL DOWN TO EXPLORE LIFECYCLE'
          : 'TAP THE TOGGLE TO BEGIN';
      }

      if (systemStatusText) {
        systemStatusText.textContent = isToggleActive 
          ? 'MODE: ADAPTIVE AI ACTIVE' 
          : 'MODE: BASELINE SYSTEM';
      }

      playTactileClickSound();

      // DO NOT CALL scrollTo() or scrollIntoView()!
    });
  }

  function playTactileClickSound() {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(isToggleActive ? 820 : 500, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(isToggleActive ? 1150 : 320, audioCtx.currentTime + 0.04);

      gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + 0.045);
    } catch (err) {}
  }

  /* ==========================================================================
     2. THESIS CURSOR SPOTLIGHT EFFECT
     ========================================================================== */

  function initThesisSpotlight() {
    if (!thesisSection || !thesisSpotlight) return;

    thesisSection.addEventListener('mousemove', (e) => {
      const rect = thesisSection.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      thesisSpotlight.style.left = `${x}px`;
      thesisSpotlight.style.top = `${y}px`;
    });
  }

  /* ==========================================================================
     3. GSAP BLUR REVEALS FOR VERTICAL ZIGZAG CARDS (01 TO 05)
     ========================================================================== */

  function initScrollTriggers() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('.blur-card, .blur-reveal-text').forEach((el) => el.classList.add('is-visible'));
      return;
    }

    // Blur reveal for all 5 vertical stage cards as user scrolls
    const blurCards = document.querySelectorAll('.blur-card');
    blurCards.forEach((card) => {
      ScrollTrigger.create({
        trigger: card,
        start: 'top 82%',
        onEnter: () => card.classList.add('is-visible'),
        onLeaveBack: () => card.classList.remove('is-visible')
      });
    });

    // Final Thesis Reveal
    const finalThesis = document.getElementById('finalThesis');
    if (finalThesis) {
      ScrollTrigger.create({
        trigger: '#thesis',
        start: 'top 75%',
        onEnter: () => finalThesis.classList.add('is-visible'),
        onLeaveBack: () => finalThesis.classList.remove('is-visible')
      });
    }
  }

  /* ==========================================================================
     4. LENIS SMOOTH SCROLL
     ========================================================================== */

  function initSmoothScroll() {
    if (typeof Lenis === 'undefined') return;

    lenisInstance = new Lenis({
      duration: 1.15,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      touchMultiplier: 1.5
    });

    lenisInstance.on('scroll', () => {
      if (window.ScrollTrigger) ScrollTrigger.update();
    });

    gsap.ticker.add((time) => {
      lenisInstance.raf(time * 1000);
    });

    gsap.ticker.lagSmoothing(0);
  }

  /* ==========================================================================
     5. STAGE CANVASES VISUALIZERS (01 TO 05)
     ========================================================================== */

  function initStageCanvases() {
    let t = 0;

    function renderStageCanvases() {
      t += 0.012;

      // Stage 1: Radar Pulse & Orbit Lines
      renderCanvas1(t);
      // Stage 2: Generative Form Grid
      renderCanvas2(t);
      // Stage 3: Particle Vector Stream
      renderCanvas3(t);
      // Stage 4: Telemetry Wave Ripples
      renderCanvas4(t);
      // Stage 5: Infinity Loop Node
      renderCanvas5(t);

      requestAnimationFrame(renderStageCanvases);
    }

    renderStageCanvases();
  }

  // Canvas 1: Consumer Insight Orbit Pulse
  function renderCanvas1(t) {
    const canvas = document.getElementById('canvasStage1');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    const cx = w / 2;
    const cy = h / 2;

    drawCenterNode(ctx, cx, cy);

    drawEllipse(ctx, cx, cy, 115, 55, -0.4, 'rgba(11, 61, 37, 0.22)');
    drawEllipse(ctx, cx, cy, 128, 70, 0.6, 'rgba(11, 61, 37, 0.18)');

    const p1 = getPointOnEllipse(cx, cy, 115, 55, -0.4, t * 0.85);
    ctx.beginPath();
    ctx.arc(p1.x, p1.y, 4.5, 0, Math.PI * 2);
    ctx.fillStyle = '#0B3D25';
    ctx.fill();
  }

  // Canvas 2: Product Innovation Grid Synthesis
  function renderCanvas2(t) {
    const canvas = document.getElementById('canvasStage2');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    const cx = w / 2;
    const cy = h / 2;

    drawCenterNode(ctx, cx, cy);

    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(t * 0.25);
    ctx.strokeStyle = 'rgba(11, 61, 37, 0.15)';
    ctx.lineWidth = 1;
    for (let r = 35; r <= 110; r += 25) {
      ctx.beginPath();
      ctx.rect(-r, -r, r * 2, r * 2);
      ctx.stroke();
    }
    ctx.restore();
  }

  // Canvas 3: Launch Particle Stream
  function renderCanvas3(t) {
    const canvas = document.getElementById('canvasStage3');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    const cx = w / 2;
    const cy = h / 2;

    drawCenterNode(ctx, cx, cy);

    ctx.strokeStyle = 'rgba(198, 245, 35, 0.4)';
    ctx.lineWidth = 1.2;
    for (let i = 0; i < 8; i++) {
      const angle = (Math.PI * 2 / 8) * i + t * 0.5;
      const x2 = cx + Math.cos(angle) * 110;
      const y2 = cy + Math.sin(angle) * 110;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    }
  }

  // Canvas 4: Consumer Feedback Wave Ripples
  function renderCanvas4(t) {
    const canvas = document.getElementById('canvasStage4');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    const cx = w / 2;
    const cy = h / 2;

    drawCenterNode(ctx, cx, cy);

    for (let i = 0; i < 3; i++) {
      const radius = ((t * 40 + i * 35) % 110) + 10;
      const alpha = Math.max(0, 1 - radius / 110) * 0.3;
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(11, 61, 37, ${alpha})`;
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }
  }

  // Canvas 5: Continuous Learning Infinity Loop
  function renderCanvas5(t) {
    const canvas = document.getElementById('canvasStage5');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    const cx = w / 2;
    const cy = h / 2;

    drawCenterNode(ctx, cx, cy);

    ctx.save();
    ctx.translate(cx, cy);
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(11, 61, 37, 0.22)';
    ctx.lineWidth = 1.5;
    for (let a = 0; a < Math.PI * 2; a += 0.05) {
      const scale = 90 / (1 + Math.sin(a) * Math.sin(a));
      const x = scale * Math.cos(a);
      const y = scale * Math.sin(a) * Math.cos(a);
      if (a === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
    ctx.restore();
  }

  function drawCenterNode(ctx, cx, cy) {
    const gradient = ctx.createRadialGradient(cx, cy, 4, cx, cy, 36);
    gradient.addColorStop(0, '#FFFFFF');
    gradient.addColorStop(0.35, '#C6F523');
    gradient.addColorStop(1, 'rgba(198, 245, 35, 0)');

    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, 36, 0, Math.PI * 2);
    ctx.fillStyle = gradient;
    ctx.fill();
    ctx.restore();

    ctx.beginPath();
    ctx.arc(cx, cy, 14, 0, Math.PI * 2);
    ctx.fillStyle = '#FFFFFF';
    ctx.fill();
  }

  function drawEllipse(context, x, y, rx, ry, rotation, strokeStyle) {
    context.save();
    context.translate(x, y);
    context.rotate(rotation);
    context.beginPath();
    context.ellipse(0, 0, rx, ry, 0, 0, Math.PI * 2);
    context.strokeStyle = strokeStyle;
    context.lineWidth = 1.2;
    context.stroke();
    context.restore();
  }

  function getPointOnEllipse(cx, cy, rx, ry, rotation, angle) {
    const px = rx * Math.cos(angle);
    const py = ry * Math.sin(angle);
    const cosR = Math.cos(rotation);
    const sinR = Math.sin(rotation);
    return {
      x: cx + (px * cosR - py * sinR),
      y: cy + (px * sinR + py * cosR)
    };
  }

  /* ==========================================================================
     6. AMBIENT BACKGROUND CANVAS (#ambientCanvas)
     ========================================================================== */

  function initAmbientBackgroundCanvas() {
    const bgCanvas = document.getElementById('ambientCanvas');
    if (!bgCanvas) return;

    const ctx = bgCanvas.getContext('2d');
    let width = (bgCanvas.width = window.innerWidth);
    let height = (bgCanvas.height = window.innerHeight);
    let rot = 0;

    function renderBg() {
      ctx.clearRect(0, 0, width, height);
      rot += 0.0004;

      ctx.save();
      ctx.translate(width * 0.82, height * 0.22);
      ctx.rotate(rot);

      ctx.beginPath();
      ctx.ellipse(0, 0, 380, 220, 0.3, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(11, 61, 37, 0.04)';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(0, 0, 270, 150, -0.4, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(198, 245, 35, 0.12)';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.restore();

      requestAnimationFrame(renderBg);
    }

    renderBg();

    window.addEventListener('resize', () => {
      width = bgCanvas.width = window.innerWidth;
      height = bgCanvas.height = window.innerHeight;
    });
  }
});
				</script>
			</section>

			<OperatingModel />
			<CTA />
	</main>
</Layout>
