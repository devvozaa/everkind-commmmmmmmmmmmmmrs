				<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  let isToggleActive = false;
  let audioCtx = null;

  // DOM Elements
  const oToggle = document.getElementById('oToggle');
  const heroToggleStatement = document.getElementById('heroToggleStatement');
  const heroScrollArrow = document.getElementById('heroScrollArrow');
  const heroInstructionText = document.getElementById('heroInstructionText');
  const thesisSection = document.getElementById('thesis');
  const thesisSpotlight = document.getElementById('thesisSpotlight');
  const toggleProtectedContent = document.getElementById('toggleProtectedContent');

  if (window.gsap && window.ScrollTrigger) {
    gsap.registerPlugin(ScrollTrigger);
  }

  initSmoothScroll();
  initToggleSwitch();
  initThesisSpotlight();
  initScrollTriggers();
  initAmbientBackgroundCanvas();
  initHorizontalLoopInfographic();

  /* ==========================================================================
     1. HERO TOGGLE SWITCH HANDLER
     ========================================================================== */

  function initToggleSwitch() {
    if (!oToggle) return;

    if (heroInstructionText) {
      heroInstructionText.addEventListener('click', () => {
        if (!isToggleActive) {
          oToggle.click();
        }
      });
    }

    oToggle.addEventListener('click', (e) => {
      e.preventDefault();
      isToggleActive = !isToggleActive;

      oToggle.classList.toggle('is-active', isToggleActive);
      oToggle.setAttribute('aria-checked', isToggleActive ? 'true' : 'false');

      if (heroToggleStatement) {
        heroToggleStatement.classList.toggle('is-active', isToggleActive);
      }
      if (heroScrollArrow) {
        heroScrollArrow.classList.toggle('is-active', isToggleActive);
      }

      if (heroInstructionText) {
        heroInstructionText.classList.toggle('is-active', isToggleActive);
        heroInstructionText.innerHTML = isToggleActive
          ? '<span class="lime-dot">•</span> TOGGLE ENGINE ACTIVE'
          : 'TAP THE TOGGLE TO BEGIN';
      }

      if (toggleProtectedContent) {
        if (isToggleActive) {
          toggleProtectedContent.classList.add('is-visible');
          if (typeof window.startLoopFromFirstStage === 'function') {
            window.startLoopFromFirstStage();
          }
          if (typeof window.recalculateLoopSegments === 'function') {
            window.recalculateLoopSegments();
          }

          if (window.lenis) window.lenis.resize();
          window.dispatchEvent(new Event('resize'));

          setTimeout(() => {
            if (window.lenis) window.lenis.resize();
            window.dispatchEvent(new Event('resize'));
            if (window.ScrollTrigger) ScrollTrigger.refresh();
          }, 650);
        } else {
          toggleProtectedContent.classList.remove('is-visible');
          if (typeof window.stopLoopInfographic === 'function') {
            window.stopLoopInfographic();
          }

          if (window.lenis) window.lenis.resize();
          window.dispatchEvent(new Event('resize'));

          setTimeout(() => {
            if (window.lenis) window.lenis.resize();
            window.dispatchEvent(new Event('resize'));
            if (window.ScrollTrigger) ScrollTrigger.refresh();
          }, 650);
        }
      }

      playTactileClickSound();
      logToggleEventToDashboard(isToggleActive);
    });
  }

  // Dual Cloud & Client Telemetry Engine Tracking
  const pageLoadTime = performance.now();
  try {
    const views = parseInt(localStorage.getItem('everkind_total_page_views') || '0', 10) + 1;
    localStorage.setItem('everkind_total_page_views', views.toString());

    fetch('/api/telemetry', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'page_view', page: 'i3' })
    }).catch(() => {});
  } catch (e) {}

  function logToggleEventToDashboard(active) {
    try {
      const latencySec = parseFloat(((performance.now() - pageLoadTime) / 1000).toFixed(1));
      
      const count = parseInt(localStorage.getItem('everkind_toggle_click_count') || '0', 10) + 1;
      localStorage.setItem('everkind_toggle_click_count', count.toString());

      const latencies = JSON.parse(localStorage.getItem('everkind_toggle_latencies') || '[]');
      latencies.push(latencySec);
      if (latencies.length > 50) latencies.shift();
      localStorage.setItem('everkind_toggle_latencies', JSON.stringify(latencies));

      const logs = JSON.parse(localStorage.getItem('everkind_live_events_log') || '[]');
      const now = new Date();
      const timeStr = now.toTimeString().split(' ')[0];
      const eventMsg = active 
        ? `Live user on i3 page activated toggle button (Mode ON)`
        : `Live user on i3 page deactivated toggle button (Mode OFF)`;
      logs.unshift({ time: timeStr, text: eventMsg });
      if (logs.length > 50) logs.pop();
      localStorage.setItem('everkind_live_events_log', JSON.stringify(logs));

      fetch('/api/telemetry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          type: 'toggle_click',
          active: active,
          latency: latencySec,
          page: 'i3'
        })
      }).catch(() => {});
    } catch (err) {}
  }

  function logStageJumpToDashboard(stageIdx, stageName) {
    try {
      const taps = JSON.parse(localStorage.getItem('everkind_stage_taps') || '{}');
      taps[stageIdx] = (taps[stageIdx] || 0) + 1;
      localStorage.setItem('everkind_stage_taps', JSON.stringify(taps));

      const logs = JSON.parse(localStorage.getItem('everkind_live_events_log') || '[]');
      const now = new Date();
      const timeStr = now.toTimeString().split(' ')[0];
      logs.unshift({ time: timeStr, text: `Stage jump event: 0${stageIdx + 1} ${stageName} activated.` });
      if (logs.length > 50) logs.pop();
      localStorage.setItem('everkind_live_events_log', JSON.stringify(logs));

      fetch('/api/telemetry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          type: 'stage_click',
          stageIndex: stageIdx,
          stageName: stageName,
          page: 'i3'
        })
      }).catch(() => {});
    } catch (e) {}
  }

  function playTactileClickSound() {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(isToggleActive ? 820 : 500, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(isToggleActive ? 1150 : 320, audioCtx.currentTime + 0.04);

      gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + 0.045);
    } catch (err) {}
  }

  /* ==========================================================================
     2. HORIZONTAL & MOBILE CONTINUOUS LEARNING LOOP INFOGRAPHIC
     ========================================================================== */

  function initHorizontalLoopInfographic() {
    const icon = {
      insight: '<circle cx="12" cy="12" r="3"></circle><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path>',
      innovation: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.4 1 2.5h6c0-1.1.4-1.9 1-2.5A6 6 0 0 0 12 3z"></path>',
      launch: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 19 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>',
      feedback: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>',
      loop: '<path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 22v-6h6"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>'
    };

    const stages = [
      { label:"Consumer Insight",    icon:icon.insight,    phase:"MAPPING CONSUMER SIGNALS" },
      { label:"Product Innovation",  icon:icon.innovation, phase:"PROTOTYPING CONCEPTS" },
      { label:"Launch",              icon:icon.launch,      phase:"SEQUENCING ROLLOUT" },
      { label:"Consumer Feedback",   icon:icon.feedback,    phase:"READING MARKET RESPONSE" },
      { label:"Continuous Learning", icon:icon.loop,        phase:"SYNTHESIZING LEARNINGS" }
    ];

    const Y = 64, R = 30;
    const xs = [90, 235, 380, 525, 670];
    const svgns = 'http://www.w3.org/2000/svg';
    function el(tag, attrs){ const e=document.createElementNS(svgns,tag); for(const k in attrs) e.setAttribute(k,attrs[k]); return e; }

    const segG = document.getElementById('segments');
    const nodesG = document.getElementById('nodes');
    const mobileCards = document.querySelectorAll('.mobile-step-card');

    if (!segG || !nodesG) return;

    const segments = [];
    for(let i=0;i<4;i++){
      const x1 = xs[i]+R+6, x2 = xs[i+1]-R-6;
      const p = el('path', { class:'seg-fwd', d:`M ${x1},${Y} L ${x2},${Y}`, 'marker-end':'url(#arrowFwd)' });
      segG.appendChild(p);
      segments.push(p);
    }
    const retPath = el('path', { class:'seg-ret', d:`M ${xs[4]},${Y+R+8} C ${xs[4]},${Y+134} ${xs[0]},${Y+134} ${xs[0]},${Y+R+8}`, 'marker-end':'url(#arrowRet)' });
    segG.appendChild(retPath);
    segments.push(retPath);

    function setPathDashArray() {
      segments.forEach(p=>{
        const len = p.getTotalLength() || 140;
        p.style.strokeDasharray = len;
        p.dataset.len = len;
        p.style.strokeDashoffset = len;
      });
    }

    setPathDashArray();

    window.recalculateLoopSegments = () => {
      segments.forEach(p => {
        const len = p.getTotalLength() || 140;
        p.style.strokeDasharray = len;
        p.dataset.len = len;
        if (p.style.strokeDashoffset !== '0') {
          p.style.strokeDashoffset = len;
        }
      });
    };

    const nodeEls = [];
    stages.forEach((s,i)=>{
      const g = el('g', { class:'node', 'data-i':i });
      const circle = el('circle', { class:'node-circle', cx:xs[i], cy:Y, r:R });
      const iconSvg = el('svg', { x:xs[i]-9, y:Y-9, width:18, height:18, viewBox:'0 0 24 24', fill:'none', 'stroke-width':'1.8', 'stroke-linecap':'round', 'stroke-linejoin':'round' });
      iconSvg.classList.add('node-icon');
      iconSvg.innerHTML = s.icon;
      const num = el('text', { class:'badge-num', x:xs[i], y:Y-R-10 });
      num.textContent = '0'+(i+1);
      const label = el('text', { class:'node-label', x:xs[i], y:Y+R+24 });
      label.textContent = s.label;
      const underline = el('line', { class:'node-underline', x1:xs[i]-16, x2:xs[i]+16, y1:Y+R+30, y2:Y+R+30 });

      g.appendChild(circle); g.appendChild(iconSvg); g.appendChild(num); g.appendChild(label); g.appendChild(underline);
      g.addEventListener('click', ()=>goTo(i));
      nodesG.appendChild(g);
      nodeEls.push(g);
    });

    // Event Listeners for Mobile Touch Cards
    mobileCards.forEach((card, idx) => {
      card.addEventListener('click', () => goTo(idx));
    });

    const statIdx = document.getElementById('statIdx');
    const statPhase = document.getElementById('statPhase');
    const progFill = document.getElementById('progFill');

    function setActive(i){
      // Highlight Desktop SVG Nodes
      nodeEls.forEach(n => n.classList.toggle('active', +n.dataset.i === i));
      // Highlight Mobile Cards
      mobileCards.forEach(c => c.classList.toggle('active', +c.dataset.i === i));

      if (statIdx) statIdx.textContent = '0'+(i+1)+' / 0'+stages.length;
      if (statPhase) statPhase.innerHTML = stages[i].phase + '<span class="cursor">_</span>';
    }

    function drawSegment(seg, duration){
      return new Promise(resolve=>{
        seg.style.transition = `stroke-dashoffset ${duration}ms linear`;
        requestAnimationFrame(()=>{ seg.style.strokeDashoffset = '0'; });
        setTimeout(resolve, duration);
      });
    }

    function setSegmentInstant(seg, filled){
      seg.style.transition = 'none';
      seg.style.strokeDashoffset = filled ? '0' : seg.dataset.len;
      void seg.offsetWidth;
    }

    function runProgress(duration){
      if (!progFill) return;
      progFill.style.transition = 'none';
      progFill.style.width = '0%';
      void progFill.offsetWidth;
      progFill.style.transition = `width ${duration}ms linear`;
      requestAnimationFrame(()=>{ progFill.style.width = '100%'; });
    }

    const HOLD = 2200;
    let runId = 0;

    async function cycle(myRun, startAt){
      let current = startAt;
      while(runId === myRun){
        setActive(current);
        runProgress(HOLD);
        await new Promise(r=>setTimeout(r, HOLD));
        if(runId !== myRun) return;

        if(current < stages.length - 1){
          await drawSegment(segments[current], 600);
          current += 1;
        } else {
          await drawSegment(segments[4], 1200);
          current = 0;
          for(let i=0;i<segments.length;i++) setSegmentInstant(segments[i], false);
        }
      }
    }

    function goTo(i){
      runId += 1;
      const myRun = runId;
      for(let k=0;k<4;k++) setSegmentInstant(segments[k], k < i);
      setSegmentInstant(segments[4], false);
      cycle(myRun, i);
    }

    window.startLoopFromFirstStage = () => {
      goTo(0);
    };

    window.stopLoopInfographic = () => {
      runId += 1;
      for(let i=0;i<segments.length;i++) setSegmentInstant(segments[i], false);
      setActive(0);
    };
  }

  /* ==========================================================================
     3. THESIS CURSOR SPOTLIGHT EFFECT
     ========================================================================== */

  function initThesisSpotlight() {
    if (!thesisSection || !thesisSpotlight) return;

    thesisSection.addEventListener('mousemove', (e) => {
      const rect = thesisSection.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      thesisSpotlight.style.left = `${x}px`;
      thesisSpotlight.style.top = `${y}px`;
    });
  }

  /* ==========================================================================
     4. GSAP BLUR REVEALS
     ========================================================================== */

  function initScrollTriggers() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('.blur-reveal-text').forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const finalThesis = document.getElementById('finalThesis');
    if (finalThesis) {
      ScrollTrigger.create({
        trigger: '#thesis',
        start: 'top 75%',
        onEnter: () => finalThesis.classList.add('is-visible'),
        onLeaveBack: () => finalThesis.classList.remove('is-visible')
      });
    }
  }

  /* ==========================================================================
     5. LENIS SMOOTH SCROLL
     ========================================================================== */

  function initSmoothScroll() {
    window.addEventListener('scroll', () => {
      if (window.ScrollTrigger) ScrollTrigger.update();
    }, { passive: true });
  }

  /* ==========================================================================
     6. AMBIENT BACKGROUND CANVAS (#ambientCanvas)
     ========================================================================== */

  function initAmbientBackgroundCanvas() {
    const bgCanvas = document.getElementById('ambientCanvas');
    if (!bgCanvas) return;

    const ctx = bgCanvas.getContext('2d');
    let width = (bgCanvas.width = window.innerWidth);
    let height = (bgCanvas.height = window.innerHeight);
    let rot = 0;

    function renderBg() {
      ctx.clearRect(0, 0, width, height);
      rot += 0.0004;

      ctx.save();
      ctx.translate(width * 0.82, height * 0.22);
      ctx.rotate(rot);

      ctx.beginPath();
      ctx.ellipse(0, 0, 380, 220, 0.3, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(11, 61, 37, 0.04)';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(0, 0, 270, 150, -0.4, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(198, 245, 35, 0.12)';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.restore();

      requestAnimationFrame(renderBg);
    }

    renderBg();

    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (Math.abs(window.innerWidth - lastWidth) > 5) {
        lastWidth = window.innerWidth;
        width = bgCanvas.width = window.innerWidth;
        height = bgCanvas.height = window.innerHeight;
      }
    });
  }
});
				</script>
			</section>

			<!-- CTA IS ALWAYS VISIBLE AT BOTTOM OUTSIDE TOGGLE UMBRELLA -->
			<CTA mobileTight />
	</main>
