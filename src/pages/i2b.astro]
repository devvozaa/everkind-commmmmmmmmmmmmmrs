				<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  let isToggleActive = false;
  let lenisInstance = null;
  let audioCtx = null;

  const loopStageNames = [
    'Consumer Insight',
    'Product Innovation',
    'Launch',
    'Consumer Feedback',
    'Continuous Learning'
  ];

  const thinkingMessages = [
    'ai agent: sensing real-time consumer signals...',
    'ai agent: synthesizing generative product innovations...',
    'ai agent: orchestrating adaptive market launch...',
    'ai agent: processing direct usage telemetry...',
    'ai agent: optimizing continuous learning loops...'
  ];

  let currentStageIndex = 0;

  // DOM Elements
  const oToggle = document.getElementById('oToggle');
  const heroToggleStatement = document.getElementById('heroToggleStatement');
  const heroScrollArrow = document.getElementById('heroScrollArrow');
  const heroInstructionText = document.getElementById('heroInstructionText');
  const thesisSection = document.getElementById('thesis');
  const thesisSpotlight = document.getElementById('thesisSpotlight');

  const activeStageName = document.getElementById('activeStageName');
  const agentThinkingText = document.getElementById('agentThinkingText');

  if (window.gsap && window.ScrollTrigger) {
    gsap.registerPlugin(ScrollTrigger);
  }

  initSmoothScroll();
  initToggleSwitch();
  initThesisSpotlight();
  initScrollTriggers();
  initAmbientBackgroundCanvas();
  initAutomatedLoopCanvas();

  /* ==========================================================================
     1. HERO TOGGLE SWITCH HANDLER
     ========================================================================== */

  function initToggleSwitch() {
    if (!oToggle) return;

    oToggle.addEventListener('click', (e) => {
      e.preventDefault();
      isToggleActive = !isToggleActive;

      oToggle.classList.toggle('is-active', isToggleActive);
      oToggle.setAttribute('aria-checked', isToggleActive ? 'true' : 'false');

      if (heroToggleStatement) {
        heroToggleStatement.classList.toggle('is-active', isToggleActive);
      }
      if (heroScrollArrow) {
        heroScrollArrow.classList.toggle('is-active', isToggleActive);
      }

      if (heroInstructionText) {
        heroInstructionText.textContent = isToggleActive
          ? 'SCROLL DOWN TO EXPLORE LIFECYCLE'
          : 'TAP THE TOGGLE TO BEGIN';
      }

      playTactileClickSound();
    });
  }

  function playTactileClickSound() {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(isToggleActive ? 820 : 500, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(isToggleActive ? 1150 : 320, audioCtx.currentTime + 0.04);

      gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + 0.045);
    } catch (err) {}
  }

  /* ==========================================================================
     2. AUTOMATED ANIMATED LOOP CANVAS (#autoLoopCanvas)
     ========================================================================== */

  function setStage(index) {
    currentStageIndex = index % loopStageNames.length;
    const stageName = loopStageNames[currentStageIndex];
    const thinkingMsg = thinkingMessages[currentStageIndex];

    if (activeStageName) {
      activeStageName.style.opacity = '0';
      activeStageName.style.transform = 'translateY(6px)';
      setTimeout(() => {
        activeStageName.textContent = stageName;
        activeStageName.style.opacity = '1';
        activeStageName.style.transform = 'translateY(0)';
      }, 150);
    }

    if (agentThinkingText) {
      agentThinkingText.style.opacity = '0';
      setTimeout(() => {
        agentThinkingText.textContent = thinkingMsg;
        agentThinkingText.style.opacity = '1';
      }, 150);
    }
  }

  // Automated Step Switcher Timer
  setInterval(() => {
    setStage((currentStageIndex + 1) % loopStageNames.length);
  }, 2600);

  function initAutomatedLoopCanvas() {
    const canvas = document.getElementById('autoLoopCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    const cx = w / 2;
    const cy = h / 2;
    const radius = 155;

    let particleAngle = -Math.PI / 2;

    function renderAutoLoop() {
      particleAngle += 0.008;
      ctx.clearRect(0, 0, w, h);

      // Outer Soft Green Glow
      const bgGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, radius + 40);
      bgGrad.addColorStop(0, 'rgba(11, 61, 37, 0.08)');
      bgGrad.addColorStop(0.5, 'rgba(198, 245, 35, 0.06)');
      bgGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = bgGrad;
      ctx.beginPath();
      ctx.arc(cx, cy, radius + 40, 0, Math.PI * 2);
      ctx.fill();

      // Main Loop Orbit Track Line (Everkind Green)
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.strokeStyle = '#0B3D25';
      ctx.globalAlpha = 0.2;
      ctx.lineWidth = 2.5;
      ctx.setLineDash([8, 8]);
      ctx.stroke();
      ctx.restore();

      // Inner Ambient Guide Ring
      ctx.beginPath();
      ctx.arc(cx, cy, radius - 24, 0, Math.PI * 2);
      ctx.strokeStyle = '#0B3D25';
      ctx.globalAlpha = 0.08;
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.globalAlpha = 1;

      // Central Pulse Core (Everkind Green #0B3D25)
      const coreGrad = ctx.createRadialGradient(cx, cy, 4, cx, cy, 55);
      coreGrad.addColorStop(0, '#0B3D25');
      coreGrad.addColorStop(0.4, 'rgba(11, 61, 37, 0.25)');
      coreGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = coreGrad;
      ctx.beginPath();
      ctx.arc(cx, cy, 55, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#0B3D25';
      ctx.beginPath();
      ctx.arc(cx, cy, 22, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#C6F523';
      ctx.beginPath();
      ctx.arc(cx, cy, 7, 0, Math.PI * 2);
      ctx.fill();

      // Draw 5 Nodes around the circle (Everkind Green Theme)
      const totalNodes = 5;
      for (let i = 0; i < totalNodes; i++) {
        const nodeAngle = (i * (2 * Math.PI / totalNodes)) - (Math.PI / 2);
        const nx = cx + Math.cos(nodeAngle) * radius;
        const ny = cy + Math.sin(nodeAngle) * radius;
        const isActive = (i === currentStageIndex);

        // Connection Line to Center
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(nx, ny);
        ctx.strokeStyle = '#0B3D25';
        ctx.globalAlpha = isActive ? 0.45 : 0.08;
        ctx.lineWidth = isActive ? 2.5 : 1;
        ctx.stroke();
        ctx.globalAlpha = 1;

        // Node Active Glow Ring
        if (isActive) {
          ctx.beginPath();
          ctx.arc(nx, ny, 26, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(11, 61, 37, 0.15)';
          ctx.fill();
        }

        // Node Main Outer Ring & Disc
        ctx.beginPath();
        ctx.arc(nx, ny, isActive ? 17 : 12, 0, Math.PI * 2);
        ctx.fillStyle = isActive ? '#0B3D25' : '#FFFFFF';
        ctx.fill();

        ctx.strokeStyle = '#0B3D25';
        ctx.lineWidth = isActive ? 3 : 1.5;
        ctx.stroke();

        // Step Label inside node
        ctx.fillStyle = isActive ? '#C6F523' : '#0B3D25';
        ctx.font = 'bold 10px "JetBrains Mono", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(`0${i+1}`, nx, ny);
      }

      // Animated Energy Beam Particle along orbit (Everkind Green + Lime)
      const px = cx + Math.cos(particleAngle) * radius;
      const py = cy + Math.sin(particleAngle) * radius;

      // Particle Trail
      for (let k = 1; k <= 6; k++) {
        const trailAngle = particleAngle - (k * 0.04);
        const tx = cx + Math.cos(trailAngle) * radius;
        const ty = cy + Math.sin(trailAngle) * radius;
        ctx.beginPath();
        ctx.arc(tx, ty, 7 - k, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(11, 61, 37, ${0.8 - k * 0.12})`;
        ctx.fill();
      }

      ctx.beginPath();
      ctx.arc(px, py, 7.5, 0, Math.PI * 2);
      ctx.fillStyle = '#0B3D25';
      ctx.shadowColor = '#0B3D25';
      ctx.shadowBlur = 12;
      ctx.fill();
      ctx.shadowBlur = 0;

      requestAnimationFrame(renderAutoLoop);
    }

    renderAutoLoop();
  }

  /* ==========================================================================
     3. THESIS CURSOR SPOTLIGHT EFFECT
     ========================================================================== */

  function initThesisSpotlight() {
    if (!thesisSection || !thesisSpotlight) return;

    thesisSection.addEventListener('mousemove', (e) => {
      const rect = thesisSection.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      thesisSpotlight.style.left = `${x}px`;
      thesisSpotlight.style.top = `${y}px`;
    });
  }

  /* ==========================================================================
     4. GSAP BLUR REVEALS
     ========================================================================== */

  function initScrollTriggers() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('.blur-reveal-text').forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const finalThesis = document.getElementById('finalThesis');
    if (finalThesis) {
      ScrollTrigger.create({
        trigger: '#thesis',
        start: 'top 75%',
        onEnter: () => finalThesis.classList.add('is-visible'),
        onLeaveBack: () => finalThesis.classList.remove('is-visible')
      });
    }
  }

  /* ==========================================================================
     5. LENIS SMOOTH SCROLL
     ========================================================================== */

  function initSmoothScroll() {
    if (typeof Lenis === 'undefined') return;

    lenisInstance = new Lenis({
      duration: 1.15,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      touchMultiplier: 1.5
    });

    lenisInstance.on('scroll', () => {
      if (window.ScrollTrigger) ScrollTrigger.update();
    });

    gsap.ticker.add((time) => {
      lenisInstance.raf(time * 1000);
    });

    gsap.ticker.lagSmoothing(0);
  }

  /* ==========================================================================
     6. AMBIENT BACKGROUND CANVAS (#ambientCanvas)
     ========================================================================== */

  function initAmbientBackgroundCanvas() {
    const bgCanvas = document.getElementById('ambientCanvas');
    if (!bgCanvas) return;

    const ctx = bgCanvas.getContext('2d');
    let width = (bgCanvas.width = window.innerWidth);
    let height = (bgCanvas.height = window.innerHeight);
    let rot = 0;

    function renderBg() {
      ctx.clearRect(0, 0, width, height);
      rot += 0.0004;

      ctx.save();
      ctx.translate(width * 0.82, height * 0.22);
      ctx.rotate(rot);

      ctx.beginPath();
      ctx.ellipse(0, 0, 380, 220, 0.3, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(11, 61, 37, 0.04)';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(0, 0, 270, 150, -0.4, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(198, 245, 35, 0.12)';
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.restore();

      requestAnimationFrame(renderBg);
    }

    renderBg();

    window.addEventListener('resize', () => {
      width = bgCanvas.width = window.innerWidth;
      height = bgCanvas.height = window.innerHeight;
    });
  }
});
				</script>
