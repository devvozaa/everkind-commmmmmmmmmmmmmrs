---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

import OurBrands from '../components/OurBrands.astro';
import CTA from '../components/CTA.astro';
import OperatingModel from '../components/OperatingModel.astro';

import WhyChooseUs from '../components/WhyChooseUs.astro';
---

<Layout title="Everkind Consumers — AI Native Consumer Wellness Platform">
	<main>
			<Hero />
			<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
			<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
			<script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
			
			<section id="everkind-ai-consumer-company" class="everkind-ai-section" aria-label="Everkind — AI Native Consumer Wellness Platform">
				<style is:inline>
@import "tailwindcss";

/* ==========================================================================
   EVERKIND — Exact Brand Guidelines & Color Tokens
   ========================================================================== */

:root {
  /* Brand Colors */
  --color-everkind-green: #0B3D25;
  --color-everkind-dark: #000000;
  --color-everkind-bg: #FFFFFF;
  --color-everkind-lightgrey: #F3F3F3;
  --color-everkind-darkgrey: #191A23;
  --color-everkind-midgrey: #292A32;
  --color-everkind-lime: #C6F523;
  --border-subtle: rgba(11, 61, 37, 0.08);

  /* Brand Typography */
  --font-serif: "GFS Didot", Georgia, serif;
  --font-sans: "Inter", system-ui, -apple-system, sans-serif;
  --font-mono: "JetBrains Mono", monospace;
}

/* Hide scrollbar for Chrome, Safari and Opera */
html::-webkit-scrollbar,
body::-webkit-scrollbar {
  display: none;
}

/* Hide scrollbar for IE, Edge and Firefox */
html, body {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}

.everkind-ai-section {
  position: relative;
  width: 100%;
  background-color: var(--color-everkind-bg);
  color: var(--color-everkind-green);
  font-family: var(--font-serif);
  overflow-x: hidden;
}

/* ==========================================================================
   AMBIENT MOTION BACKGROUND & HERO AURA
   ========================================================================== */

.ambient-background {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

#ambientCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.65;
}

.hero-bg-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(198, 245, 35, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
  z-index: 0;
}

/* ==========================================================================
   MAIN SCROLL SECTIONS
   ========================================================================== */

.everkind-interactive-app {
  position: relative;
  z-index: 2;
  width: 100%;
}

.screen-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  box-sizing: border-box;
  padding: 2.5rem 5vw;
}

.mono-micro {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-everkind-midgrey);
}

.platform-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.4rem 1rem;
  border-radius: 9999px;
  background: rgba(11, 61, 37, 0.05);
  border: 1px solid rgba(11, 61, 37, 0.12);
  margin-bottom: 1.5rem;
}

.lime-dot {
  color: var(--color-everkind-lime);
  margin-right: 0.35rem;
}

/* ==========================================================================
   SCREEN 1: HERO SECTION
   ========================================================================== */

.hero-section {
  min-height: auto;
  padding: 2rem 5vw 3rem;
}

.hero-orbit-wrapper {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 580px;
  height: 580px;
  pointer-events: none;
  z-index: 1;
}

.hero-orbit-svg {
  width: 100%;
  height: 100%;
  animation: slowOrbitRotate 90s linear infinite;
  transform-origin: center center;
}

@keyframes slowOrbitRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.hero-inner {
  max-width: 1100px;
  width: 100%;
  background-color: var(--color-everkind-lightgrey);
  border-radius: 24px;
  padding: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  border: 1px solid var(--border-subtle);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
}

.hero-headline {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 4.4vw, 3.8rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-weight: 400;
  color: var(--color-everkind-green);
  text-align: center;
  margin: 0 auto;
}

.o-toggle {
  display: inline-flex;
  align-items: center;
  position: relative;
  width: 1.52em;
  height: 0.72em;
  vertical-align: 0.02em;
  margin: 0 0.04em;
  border-radius: 9999px;
  background-color: var(--color-everkind-dark);
  border: none;
  cursor: pointer;
  outline: none;
  padding: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
  transition: transform 0.25s ease, background-color 0.3s ease;
}

.o-toggle:hover {
  transform: scale(1.04);
}

.o-toggle:focus-visible {
  box-shadow: 0 0 0 3px rgba(198, 245, 35, 0.6);
}

.toggle-track {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 9999px;
}

.toggle-knob {
  position: absolute;
  top: 50%;
  left: 0.06em;
  transform: translateY(-50%);
  width: 0.6em;
  height: 0.6em;
  border-radius: 50%;
  background-color: var(--color-everkind-lime);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
}

.o-toggle.is-active .toggle-knob {
  transform: translate(0.8em, -50%);
}

.hero-statement-container {
  margin-top: 1.5rem;
  max-width: 780px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-toggle-statement {
  font-family: var(--font-serif);
  font-size: clamp(1.15rem, 2.2vw, 1.65rem);
  line-height: 1.35;
  color: var(--color-everkind-green);
  opacity: 0;
  filter: blur(12px);
  transform: translateY(16px);
  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
              filter 0.6s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}

.hero-toggle-statement.is-active {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0);
  pointer-events: auto;
}

.hero-scroll-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  margin-top: 1.25rem;
  opacity: 0;
  transform: translateY(12px);
  pointer-events: none;
  transition: opacity 0.5s ease 0.2s, transform 0.5s ease 0.2s;
}

.hero-scroll-arrow.is-active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.arrow-svg {
  width: 22px;
  height: 22px;
  color: var(--color-everkind-green);
  animation: pulseBounce 1.8s infinite;
}

@keyframes pulseBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

.hero-footer-micro {
  margin-top: 1.75rem;
  text-align: center;
}

.emphasis-italic {
  font-style: italic;
  color: var(--color-everkind-green);
}

/* ==========================================================================
   AUTOMATED ANIMATED LOOP SECTION (WHITE BACKGROUND & EVERKIND GREEN GRAPH)
   ========================================================================== */

.white-loop-section {
  padding: 1.5rem 5vw 0.5rem;
  width: 100%;
}

.white-loop-card {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  background-color: #FFFFFF;
  border-radius: 24px;
  color: var(--color-everkind-green);
  padding: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem);
  position: relative;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(11, 61, 37, 0.05), 0 2px 10px rgba(0, 0, 0, 0.02);
  border: 1px solid rgba(11, 61, 37, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.white-loop-spotlight {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 700px;
  height: 700px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(11, 61, 37, 0.06) 0%, rgba(198, 245, 35, 0.04) 50%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

.white-loop-top-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  position: relative;
  z-index: 2;
  border-bottom: 1px solid rgba(11, 61, 37, 0.08);
  padding-bottom: 0.85rem;
}

.white-loop-top-bar .mono-micro {
  color: var(--color-everkind-midgrey);
}

/* Agent Thinking Telemetry Bar */
.agent-thinking-bar {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.9rem;
  border-radius: 9999px;
  background: rgba(11, 61, 37, 0.04);
  border: 1px solid rgba(11, 61, 37, 0.1);
  margin-bottom: 1.25rem;
  position: relative;
  z-index: 2;
}

.thinking-dot {
  color: var(--color-everkind-green);
  font-size: 0.8rem;
  animation: agentPulse 1.5s infinite ease-in-out;
}

@keyframes agentPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.2); }
}

.thinking-text {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--color-everkind-green);
  letter-spacing: 0.04em;
  text-transform: lowercase;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.white-loop-canvas-wrapper {
  width: 100%;
  max-width: 440px;
  aspect-ratio: 1 / 1;
  position: relative;
  margin: 0 auto;
  z-index: 2;
}

#autoLoopCanvas {
  width: 100%;
  height: 100%;
  display: block;
}

.active-stage-display {
  margin-top: 1.5rem;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}

.active-stage-name {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 4vw, 3rem);
  color: var(--color-everkind-green);
  font-weight: 400;
  letter-spacing: -0.02em;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

/* ==========================================================================
   SCREEN 3: FINAL THESIS SECTION (TIGHTER GAP)
   ========================================================================== */

.thesis-section {
  min-height: auto;
  padding: 1.25rem 5vw 4rem;
  background-color: transparent;
}

.thesis-card-wrapper {
  max-width: 1100px;
  width: 100%;
  margin: 0 auto;
  background-color: var(--color-everkind-green);
  border-radius: 24px;
  color: var(--color-everkind-bg);
  padding: clamp(3.5rem, 6vw, 5rem) clamp(2rem, 4vw, 4rem);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.thesis-spotlight {
  position: absolute;
  width: 600px;
  height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(198, 245, 35, 0.12) 0%, rgba(11, 61, 37, 0) 70%);
  pointer-events: none;
  transform: translate(-50%, -50%);
  top: 50%;
  left: 50%;
  transition: opacity 0.5s ease;
}

.thesis-top-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2.5rem;
}

.thesis-top-bar .mono-micro {
  color: rgba(255, 255, 255, 0.7);
}

.thesis-inner {
  max-width: 920px;
  width: 100%;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  text-align: center;
}

.thesis-text {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 2.8vw, 2.4rem);
  line-height: 1.32;
  font-weight: 400;
  color: var(--color-everkind-bg);
  letter-spacing: -0.01em;
  text-align: center;
}

.blur-reveal-text {
  opacity: 0;
  filter: blur(20px);
  transform: translateY(30px);
  will-change: opacity, filter, transform;
  transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1),
              filter 1.1s cubic-bezier(0.16, 1, 0.3, 1),
              transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
}

.blur-reveal-text.is-visible {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0);
}

.lime-italic {
  font-style: italic;
  color: var(--color-everkind-lime);
  font-weight: 400;
}

.highlight-white {
  font-weight: 400;
  color: var(--color-everkind-bg);
  border-bottom: 2px solid var(--color-everkind-lime);
  padding-bottom: 2px;
}

/* ==========================================================================
   RESPONSIVE BREAKPOINTS
   ========================================================================== */

@media (max-width: 900px) {
  .hero-inner {
    padding: 3rem 1.5rem;
    border-radius: 18px;
  }

  .hero-headline {
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    line-height: 1.08;
  }

  .o-toggle {
    width: 1.4em;
    height: 0.66em;
  }

  .o-toggle.is-active .toggle-knob {
    transform: translate(0.72em, -50%);
  }

  .hero-toggle-statement {
    font-size: clamp(1.1rem, 3.5vw, 1.4rem);
  }

  .white-loop-card {
    padding: 2rem 1.25rem;
    border-radius: 18px;
  }

  .thesis-card-wrapper {
    padding: 3rem 1.5rem;
    border-radius: 18px;
  }

  .thesis-text {
    font-size: clamp(1.3rem, 4.5vw, 1.8rem);
  }

  .hero-orbit-wrapper {
    width: 420px;
    height: 420px;
  }
}
				</style>

				<!-- Ambient Motion Graphics Layer & Orbital Rings Behind Content -->
				<div class="ambient-background" aria-hidden="true">
					<canvas id="ambientCanvas"></canvas>
