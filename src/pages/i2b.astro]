						<div class="hero-orbit-wrapper" aria-hidden="true">
							<svg viewBox="0 0 600 600" class="hero-orbit-svg">
								<ellipse cx="300" cy="300" rx="260" ry="140" stroke="rgba(11, 61, 37, 0.12)" stroke-width="1.2" fill="none" transform="rotate(-15 300 300)" />
								<ellipse cx="300" cy="300" rx="220" ry="190" stroke="rgba(198, 245, 35, 0.25)" stroke-width="1.2" fill="none" stroke-dasharray="6 8" transform="rotate(25 300 300)" />
								<circle cx="160" cy="220" r="4" fill="#0B3D25" opacity="0.6" />
